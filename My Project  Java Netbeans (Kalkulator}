    private void BtnHasilActionPerformed(java.awt.event.ActionEvent evt) {                                         
        // TODO add your handling code here:
        switch (pilih){
            case 1:
                jumlah = Math.sin(Math.toRadians(Double.parseDouble(angka)));
                angka =Double.toString(jumlah);
                TampilTeks.setText(angka);
                break;
            case 2:
                jumlah = Math.cos(Math.toRadians(Double.parseDouble(angka)));
                angka =Double.toString(jumlah);
                TampilTeks.setText(angka);
                
                break;
            case 3:
                jumlah = Math.tan(Math.toRadians(Double.parseDouble(angka)));
                angka =Double.toString(jumlah);
                TampilTeks.setText(angka);
                
                break;
            case 4:
                bil2 = Double.parseDouble(angka); 
                jumlah = Math.pow(bil1, bil2);
                angka = Double.toString(jumlah);
                TampilTeks.setText(angka);
                break;
            case 5:
                jumlah = Math.sqrt(Double.parseDouble(angka));
                angka = Double.toString(jumlah);
                TampilTeks.setText(angka);
                break;
        }
    }                                        

